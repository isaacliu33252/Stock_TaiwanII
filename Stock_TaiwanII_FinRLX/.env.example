# ────────────────────────────────────────────────────────────────
# FinRL-X 台股系統 - 環境變數範例
# 複製此檔案為 .env 並填入實際值
# ────────────────────────────────────────────────────────────────

# ── Alpaca（等申請後開通）────────────────────────────
APCA_API_KEY=your_alpaca_api_key_here
APCA_API_SECRET=your_alpaca_api_secret_here
APCA_BASE_URL=https://paper-api.alpaca.markets   # paper trading
# APCA_BASE_URL=https://api.alpaca.markets        # live（申請後切換）

# ── FinRL-X 通用設定 ──────────────────────────────
DATA_BASE_DIR=./data
LOG_LEVEL=INFO
ENVIRONMENT=paper

# ── 券商設定 ─────────────────────────────────────
BROKERAGE_FEE_RATE=0.001425
MIN_BROKERAGE_FEE=20.0
TRANSACTION_TAX_RATE=0.003
