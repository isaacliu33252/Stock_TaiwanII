# Copy this file to your private local env file and fill in real values.
# Do not commit real credentials or certificate paths.

FUBON_PERSONAL_ID=H123456789
FUBON_PASSWORD=your_fubon_password
FUBON_CERT_PATH=/absolute/path/to/your_certificate.pfx
FUBON_CERT_PASSWORD=your_certificate_password

# Optional. If omitted, you can still inspect login results manually.
FUBON_ACCOUNT=
